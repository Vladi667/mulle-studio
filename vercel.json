{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo no-install",
  "buildCommand": "echo no-build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/fr/agence-web-lausanne",
      "destination": "/fr/agence-web-suisse-romande",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.agencefritz.com" }],
      "destination": "https://agencefritz.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.agencefritz.com" }],
      "destination": "https://agencefritz.com/:path*",
      "permanent": true
    }
  ]
}
